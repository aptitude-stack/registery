# ---------------------------
# Database Configuration
# ---------------------------
POSTGRES_IMAGE=postgres:15.17
POSTGRES_DB=aptitude
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<local-postgres-password>
POSTGRES_PORT=5432
TEST_POSTGRES_DB=aptitude_test
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=<local-test-postgres-password>
TEST_POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@127.0.0.1:5432/aptitude
# Optional for production: use a direct database host for Alembic when DATABASE_URL
# points at a pooled runtime host.
MIGRATION_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@<direct-neon-host>/aptitude
TEST_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@127.0.0.1:5433/aptitude_test

# ---------------------------
# Application Runtime Defaults
# ---------------------------
#`APP_ENV` remains the only runtime-profile switch. Use `APP_ENV=prod` on the production server to enable prod-only guardrails (e.g. `ALLOWED_HOSTS_JSON`).
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=auto
APP_NAME=aptitude-registry

# ---------------------------
# Governed Service Tokens
# ---------------------------
AUTH_SERVICE_TOKENS_JSON='[{"token_id":"reader-token","secret_digest":"5f2a948f1a0f51d636721e4381eaf64fc8032a03b540a12da0645e0edc564084","scopes":["read"],"namespace_grants":[{"namespace":"public","roles":["read"],"promotion_channels":["prod"]}],"active":true},{"token_id":"publisher-token","secret_digest":"99e880bea53395534bf471d5d086ac2b2f6d45c6fe7c6c9ac7f6225cbe19c559","scopes":["read","publish"],"namespace_grants":[{"namespace":"public","roles":["read","publish"],"promotion_channels":["prod"]}],"active":true},{"token_id":"admin-token","secret_digest":"f0f642b692ba908c91a9afe3c53878700b32e66c8132fc071109b4af48625d46","scopes":["read","publish","review","admin"],"namespace_grants":[{"namespace":"*","roles":["read","publish","review","admin"],"promotion_channels":["*"]}],"active":true}]'

# ---------------------------
# Prod-Only Runtime Guardrails
# ---------------------------
# Required when `APP_ENV=prod`. Include the deployed API host and the Render service host during rollout.
ALLOWED_HOSTS_JSON='["127.0.0.1","localhost","api.aptitude-registry.dev","<render-service>.onrender.com"]'
