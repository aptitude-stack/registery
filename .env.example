# ---------------------------
# Database Configuration
# ---------------------------
POSTGRES_IMAGE=postgres:15.17
POSTGRES_DB=aptitude
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<local-postgres-password>
POSTGRES_PORT=5432
TEST_POSTGRES_DB=aptitude_test
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=<local-test-postgres-password>
TEST_POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@127.0.0.1:5432/aptitude
TEST_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@127.0.0.1:5433/aptitude_test

# ---------------------------
# Application Runtime Defaults
# ---------------------------
#`APP_ENV` remains the only runtime-profile switch. Use `APP_ENV=prod` on the production server to enable prod-only guardrails (e.g. `ALLOWED_HOSTS_JSON`).
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=auto
APP_NAME=aptitude-registry

# ---------------------------
# Governed Service Tokens
# ---------------------------
AUTH_SERVICE_TOKENS_JSON='[{"token_id":"reader-token","secret_digest":"<sha256-of-reader-secret>","scopes":["read"],"active":true},{"token_id":"publisher-token","secret_digest":"<sha256-of-publisher-secret>","scopes":["read","publish"],"active":true},{"token_id":"admin-token","secret_digest":"<sha256-of-admin-secret>","scopes":["read","publish","admin"],"active":true}]'

# ---------------------------
# Prod-Only Runtime Guardrails
# ---------------------------
# Required when `APP_ENV=prod`.
ALLOWED_HOSTS_JSON='["127.0.0.1","localhost"]'
