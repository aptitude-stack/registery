# Aptitude Registry local configuration template.
# Copy this file to `.env` for local runs. Production deployments should set the
# same variables through the provider's environment/secret manager instead.

# ---------------------------
# Local Docker/Compose
# ---------------------------
POSTGRES_IMAGE=pgvector/pgvector:pg15
POSTGRES_DB=aptitude
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

TEST_POSTGRES_DB=aptitude_test
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=postgres
TEST_POSTGRES_PORT=5433

APP_IMAGE=y0ncha/aptitude-registry:local
APP_PORT=8000

# ---------------------------
# Database
# ---------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/aptitude
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/aptitude_test
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Optional: use a direct database host for Alembic when DATABASE_URL points at a
# pooled runtime host, for example Neon pooler URLs in production.
# MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@direct-host/dbname

# ---------------------------
# Runtime
# ---------------------------
APP_ENV=dev
APP_NAME=aptitude-registry
LOG_LEVEL=INFO
LOG_FORMAT=auto
PORT=8000
UVICORN_RELOAD=false

# Optional: point app-process startup at a different dotenv file. Do not set
# this in the default `.env` unless you intentionally want to bypass `.env`.
# APP_SETTINGS_ENV_FILE=.env.local-prod

# ---------------------------
# Auth and Host Guardrails
# ---------------------------
# Local dev fixture tokens:
# - reader-token.dev-reader-secret
# - publisher-token.dev-publisher-secret
# - admin-token.dev-admin-secret
AUTH_SERVICE_TOKENS_JSON='[{"token_id":"reader-token","secret_digest":"5f2a948f1a0f51d636721e4381eaf64fc8032a03b540a12da0645e0edc564084","scopes":["read"],"namespace_grants":[{"namespace":"public","roles":["read"],"promotion_channels":["prod"]}],"active":true},{"token_id":"publisher-token","secret_digest":"99e880bea53395534bf471d5d086ac2b2f6d45c6fe7c6c9ac7f6225cbe19c559","scopes":["read","publish"],"namespace_grants":[{"namespace":"public","roles":["read","publish"],"promotion_channels":["prod"]}],"active":true},{"token_id":"admin-token","secret_digest":"f0f642b692ba908c91a9afe3c53878700b32e66c8132fc071109b4af48625d46","scopes":["read","publish","review","admin"],"namespace_grants":[{"namespace":"*","roles":["read","publish","review","admin"],"promotion_channels":["*"]}],"active":true}]'

# Required when APP_ENV=prod. Include the deployed API host and any platform
# health-check host that reaches this service.
ALLOWED_HOSTS_JSON='["127.0.0.1","localhost","server"]'

ACTIVE_POLICY_PROFILE=default
# Optional: JSON object keyed by policy profile name. Usually leave unset and
# use the built-in default profile.
# POLICY_PROFILES_JSON='{"strict":{"publish_rules":{"verified":{"required_scope":"review","provenance_required":true}}}}'

# ---------------------------
# Semantic Discovery
# ---------------------------
SEMANTIC_DISCOVERY_MODE=off
SEMANTIC_EMBEDDING_PROVIDER=openai
SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_EMBEDDING_INDEX_KEY=openai:text-embedding-3-small:description-tags-v1
SEMANTIC_EMBEDDING_DIMENSIONS=1536

# Required only when SEMANTIC_DISCOVERY_MODE is shadow or hybrid, or when
# running scripts/index_semantic_embeddings.py.
# OPENAI_API_KEY=sk-...

SEMANTIC_CANDIDATE_LIMIT=20
SEMANTIC_QUERY_TIMEOUT_MS=150
SEMANTIC_HNSW_EF_SEARCH=100

# Optional co-usage ranking controls.
CO_USAGE_RANKING_ENABLED=false
CO_USAGE_BOOST_CAP=0.05
CO_USAGE_CONTEXT_LIMIT=10

# Optional Render Workflow task trigger for semantic indexing.
# RENDER_API_KEY=rnd_...
# RENDER_SEMANTIC_INDEX_WORKFLOW_TASK=aptitude-registry-semantic-indexing/index_semantic_embeddings

# ---------------------------
# OpenTelemetry / Grafana Cloud
# ---------------------------
OTEL_ENABLED=false
OTEL_SDK_DISABLED=true

# Required in APP_ENV=prod when OTEL_ENABLED=true.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-token>
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=aptitude,deployment.environment.name=dev
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_LOG_LEVEL=INFO
