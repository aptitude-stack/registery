# Aptitude Registry local configuration template.
# Copy this file to `.env` for local runs. Production deployments should set the
# same variables through the provider's environment/secret manager instead.

# ---------------------------
# Local Docker/Compose
# ---------------------------
POSTGRES_IMAGE=pgvector/pgvector:pg15
POSTGRES_DB= # aptitude, testdb, etc.
POSTGRES_USER= # postgres, testuser, etc.
POSTGRES_PASSWORD= # postgres, testpassword, etc.
POSTGRES_PORT= # 5432, 5433, etc.

TEST_POSTGRES_DB= # aptitude_test, testdb, etc.
TEST_POSTGRES_USER= # postgres, testuser, etc.
TEST_POSTGRES_PASSWORD= # postgres, testpassword, etc.
TEST_POSTGRES_PORT= # 5433, 5434, etc.

APP_IMAGE=y0ncha/aptitude-registry:local
APP_PORT= # 8000, 8001, etc.

# ---------------------------
# Database
# ---------------------------
DATABASE_URL=postgresql+psycopg:// # postgres:postgres@127.0.0.1:5432/aptitude
TEST_DATABASE_URL=postgresql+psycopg:// # postgres:postgres@127.0.0.1:5433/aptitude_test
DATABASE_CONNECT_TIMEOUT_SECONDS= # 5, 10, etc.

# Optional: use a direct database host for Alembic when DATABASE_URL points at a
# pooled runtime host, for example Neon pooler URLs in production.
# MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@direct-host/dbname

# ---------------------------
# Runtime
# ---------------------------
APP_ENV= # dev, prod
APP_NAME= # aptitude-registry, aptitude-registry-test, etc.
LOG_LEVEL= # INFO, DEBUG, WARNING, ERROR, CRITICAL
LOG_FORMAT= # auto, json, pretty
PORT= # 8000, 8001, etc.
UVICORN_RELOAD= # false, true

# Optional: point app-process startup at a different dotenv file. Do not set
# this in the default `.env` unless you intentionally want to bypass `.env`.
# APP_SETTINGS_ENV_FILE=.env.local-prod

# ---------------------------
# Auth and Host Guardrails
# ---------------------------
# Service tokens use `Authorization: Bearer <token_id>.<secret>`.
# Store only sha256(secret) in AUTH_SERVICE_TOKENS_JSON, never the raw secret.
# Generate local values with:
#   uv run python scripts/generate_service_token.py --token-id telemetry_prod
# Then set the matching website secret as:
#   REGISTRY_TELEMETRY_TOKEN=<token_id>.<secret>
AUTH_SERVICE_TOKENS_JSON='[]'

# Required when APP_ENV=prod. Include the deployed API host and any platform
# health-check host that reaches this service.
ALLOWED_HOSTS_JSON='["127.0.0.1","localhost"]'

ACTIVE_POLICY_PROFILE= # default, strict, etc.
# Optional: JSON object keyed by policy profile name. Usually leave unset and
# use the built-in default profile.
# POLICY_PROFILES_JSON='{"strict":{"publish_rules":{"verified":{"required_scope":"review","provenance_required":true}}}}'

# ---------------------------
# Semantic Discovery
# ---------------------------
SEMANTIC_DISCOVERY_MODE= # hybrid by default; set off for lexical-only, shadow for observed semantic retrieval
SEMANTIC_EMBEDDING_PROVIDER= # openai, anthropic, etc.
SEMANTIC_EMBEDDING_MODEL= # text-embedding-3-small, claude-3-5-sonnet-20240620, etc.
SEMANTIC_EMBEDDING_INDEX_KEY= # openai:text-embedding-3-small:description-tags-v1, anthropic:claude-3-5-sonnet-20240620:description-tags-v1, etc.
SEMANTIC_EMBEDDING_DIMENSIONS= # 1536, 4096, etc.

# Required for the default hybrid mode, shadow mode, and
# scripts/index_semantic_embeddings.py. Set SEMANTIC_DISCOVERY_MODE=off for
# lexical-only startup without provider credentials.
# OPENAI_API_KEY=sk-...

SEMANTIC_CANDIDATE_LIMIT= # 20, 50, etc.
SEMANTIC_QUERY_TIMEOUT_MS= # 150, 500, etc.
SEMANTIC_HNSW_EF_SEARCH= # 100, 200, etc.

# Optional co-usage ranking controls.
CO_USAGE_RANKING_ENABLED= # false, true
CO_USAGE_BOOST_CAP= # 0.05, 0.1, etc.
CO_USAGE_CONTEXT_LIMIT= # 10, 20, etc.

# Optional Render Workflow task trigger for semantic indexing.
# RENDER_API_KEY=rnd_...
# RENDER_SEMANTIC_INDEX_WORKFLOW_TASK=aptitude-registry-semantic-indexing/index_semantic_embeddings

# ---------------------------
# OpenTelemetry / Grafana Cloud
# ---------------------------
OTEL_ENABLED= # false, true
OTEL_SDK_DISABLED= # true, false

# Required in APP_ENV=prod when OTEL_ENABLED=true.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-token>
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=aptitude,deployment.environment.name=dev
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_LOG_LEVEL=INFO
